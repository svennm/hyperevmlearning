# ── HyperEVM testnet — everlasting HYPE options ──
# Copy to .env (gitignored). NEVER put a real / mainnet key here.
# Use a DEDICATED throwaway testnet wallet only (a fresh Trust Wallet account
# that holds testnet funds and nothing else).

# RPC + chain
HYPEREVM_TESTNET_RPC=https://rpc.hyperliquid-testnet.xyz/evm
CHAIN_ID=998

# Dedicated testnet dev wallet (throwaway — testnet funds ONLY)
DEPLOYER_ADDRESS=0xYOUR_TESTNET_DEV_ADDRESS
DEPLOYER_PRIVATE_KEY=0xYOUR_TESTNET_DEV_PRIVATE_KEY   # testnet-only; never a real-funds key

# Keeper that posts the hourly mark (can reuse the deployer on testnet)
KEEPER_PRIVATE_KEY=0xYOUR_TESTNET_KEEPER_KEY

# HYPE perp oracle index on HL testnet (verified 2026-07-02 via /info meta)
HYPE_PERP_INDEX=135
HYPE_SZ_DECIMALS=2   # price = oraclePx(135) / 10^(6-2)
